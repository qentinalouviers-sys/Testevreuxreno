# ─────────────────────────────────────────────────────────────
#  Variables d'environnement — Rénovation Énergétique Évreux
#  Copiez ce fichier en `.env.local` et renseignez vos valeurs.
# ─────────────────────────────────────────────────────────────

# ── Envoi des leads par email (Resend) ──────────────────────
# Clé API Resend — https://resend.com/api-keys
# Si absente en développement, les leads sont simplement loggés
# dans la console (aucun email envoyé).
RESEND_API_KEY=

# Adresse expéditrice vérifiée sur votre domaine Resend.
# Ex : "NormaRénov <devis@mail.votre-domaine.fr>"
LEAD_FROM_EMAIL="NormaRénov <onboarding@resend.dev>"

# Adresse(s) qui reçoivent les demandes de devis.
# Plusieurs adresses possibles, séparées par une virgule.
LEAD_TO_EMAIL=contact@votre-domaine.fr

# ── Webhook optionnel (CRM / Make / n8n / Zapier) ───────────
# Si renseigné, chaque lead est aussi POSTé (JSON) vers cette URL,
# en plus de l'email. Laisser vide pour désactiver.
LEAD_WEBHOOK_URL=

# ── URL publique du site (SEO / sitemap / Open Graph) ───────
# Sans slash final. Ex : https://www.normarenov.fr
NEXT_PUBLIC_SITE_URL=https://www.normarenov.fr
