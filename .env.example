# ------------------------------------------------------------------
# Al Arifa — variables d'environnement
# Copier ce fichier en `.env.local` et compléter les valeurs utiles.
# Toutes sont optionnelles : le site fonctionne sans aucune d'entre elles.
# ------------------------------------------------------------------

# URL publique du site (utilisée pour les métadonnées, le sitemap et les données structurées)
NEXT_PUBLIC_SITE_URL=https://al-arifa.com

# Endpoint du formulaire de contact (Formspree, Web3Forms, Basin…).
# Si cette variable est absente, le formulaire bascule sur WhatsApp
# avec un message pré-rempli au lieu de simuler un envoi.
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx

# ------------------------------------------------------------------
# Déploiement GitHub Pages (renseignés automatiquement par le workflow CI)
# ------------------------------------------------------------------
# STATIC_EXPORT=true
# PAGES_BASE_PATH=/nom-du-depot
